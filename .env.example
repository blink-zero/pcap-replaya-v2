# Copy to .env. Backend-only settings; never put credentials in VITE_* variables.
# Leave the local API key blank only on trusted networks.
PCAP_API_KEY=
PCAP_CORS_ORIGINS=*
PCAP_HOST=0.0.0.0
PCAP_PORT=8000
PCAP_MAX_FILE_SIZE=1073741824
PCAP_ANALYSIS_PACKET_LIMIT=500000
# Compose overrides upload/database paths for its persistent volumes.
# PCAP_UPLOAD_FOLDER=/path/to/uploads
# PCAP_DB_PATH=/path/to/replaya.db

# PCAPHub public browsing needs no credentials. Imports require a server key.
PCAP_PCAPHUB_API_KEY=
# api-key sends X-API-Key; bearer sends Authorization: Bearer.
PCAP_PCAPHUB_AUTH_MODE=api-key
PCAP_PCAPHUB_MAX_DOWNLOAD_BYTES=268435456
PCAP_PCAPHUB_TIMEOUT_SECONDS=120
